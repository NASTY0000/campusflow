generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  city      String
  country   String   @default("Nigeria")
  currency  String   @default("NGN")
  motto     String?
  createdAt DateTime @default(now())

  users     User[]
  students  Student[]
  feeItems  FeeItem[]
  invoices  Invoice[]
  payments  Payment[]
  receipts  Receipt[]
  enrollments Enrollment[]
  records   AcademicRecord[]
  ledger    LedgerEntry[]
  auditLogs AuditLog[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         String
  studentId    String?  @unique
  student      Student? @relation(fields: [studentId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  paymentsReceived Payment[]  @relation("ReceivedBy")
  auditLogs        AuditLog[]
  ledgerEntries    LedgerEntry[] @relation("LedgerActor")

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Student {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matricNumber    String
  firstName       String
  lastName        String
  otherNames      String?
  email           String
  phone           String?
  gender          String
  dateOfBirth     DateTime?
  nationality     String    @default("Nigerian")
  stateOfOrigin   String?
  address         String?
  programme       String
  faculty         String
  department      String
  level           String
  sessionAdmitted String
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user        User?
  enrollments Enrollment[]
  records     AcademicRecord[]
  invoices    Invoice[]
  payments    Payment[]
  ledger      LedgerEntry[]

  @@unique([tenantId, matricNumber])
  @@unique([tenantId, email])
  @@index([tenantId, lastName])
  @@index([tenantId, programme])
  @@index([tenantId, status])
}

model Enrollment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session    String
  semester   String
  programme  String
  level      String
  status     String   @default("ENROLLED")
  enrolledAt DateTime @default(now())

  @@index([tenantId, studentId])
  @@index([tenantId, session])
}

model AcademicRecord {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session     String
  semester    String
  courseCode  String
  courseTitle String
  creditUnit  Int
  grade       String
  gradePoint  Float

  @@index([tenantId, studentId])
}

model FeeItem {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  type        String
  amountKobo  Int
  session     String?
  level       String?
  programme   String?
  isActive    Boolean @default(true)
  description String?

  lines InvoiceLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
}

model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoiceNumber String
  session       String
  semester      String?
  status        String    @default("ISSUED")
  totalKobo     Int
  paidKobo      Int       @default(0)
  dueDate       DateTime?
  issuedAt      DateTime  @default(now())
  notes         String?

  items    InvoiceLine[]
  payments Payment[]
  ledger   LedgerEntry[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeItemId   String?
  feeItem     FeeItem? @relation(fields: [feeItemId], references: [id])
  description String
  quantity    Int      @default(1)
  amountKobo  Int
}

model Payment {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amountKobo   Int
  method       String
  reference    String
  status       String    @default("SUCCESS")
  paidAt       DateTime  @default(now())
  receivedById String?
  receivedBy   User?     @relation("ReceivedBy", fields: [receivedById], references: [id])
  notes        String?

  receipt Receipt?
  ledger  LedgerEntry[]

  @@unique([tenantId, reference])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

model Receipt {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  receiptNumber String
  issuedAt      DateTime @default(now())

  @@unique([tenantId, receiptNumber])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id])
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id])
  type        String
  account     String
  amountKobo  Int
  description String
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("LedgerActor", fields: [createdById], references: [id])

  @@index([tenantId, studentId])
  @@index([tenantId, createdAt])
  @@index([tenantId, account])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
}
